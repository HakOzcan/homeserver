<?xml version="1.0" encoding="utf-8"?>
<!-- Overrides media3-ui's settings-row layout (same filename => app resource wins
over the library's). Identical to the library original EXCEPT the text view:
ours caps the width and wraps to 2 lines, so long track names like
"English Surround 5.1 (Dolby)" stay readable instead of running off the
fixed-width popup. IDs (exo_check / exo_text) are preserved so media3's
adapter still binds to them. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:minWidth="@dimen/exo_setting_width"
              android:minHeight="@dimen/exo_settings_height"
              android:background="?android:attr/selectableItemBackground"
              android:layoutDirection="locale"
              android:orientation="horizontal">

    <ImageView
        android:id="@+id/exo_check"
        android:layout_width="@dimen/exo_settings_icon_size"
        android:layout_height="@dimen/exo_settings_icon_size"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:layout_marginTop="12dp"
        android:visibility="invisible"
        android:src="@drawable/exo_styled_controls_check" />

    <!-- PARKED: was cc.hakserver.tv.ui.common.MarqueeTextView with marquee attrs.
    The marquee never animated on the Fire TV, so we wrap instead: deterministic,
    no focus/selection or timing dependency. maxWidth keeps the popup from
    stretching; maxLines lets a long track name flow to a second line.
    MarqueeTextView.kt is kept in the tree for when we revisit this. -->
    <TextView
        android:id="@+id/exo_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/exo_settings_height"
        android:maxWidth="260dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_marginEnd="4dp"
        android:layout_marginRight="4dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:gravity="center|start"
        android:textColor="@color/exo_white"
        android:textDirection="locale"
        android:textSize="@dimen/exo_settings_main_text_size" />

    </LinearLayout>
