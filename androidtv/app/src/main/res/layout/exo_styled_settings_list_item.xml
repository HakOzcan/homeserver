<?xml version="1.0" encoding="utf-8"?>
<!-- Overrides media3-ui's TOP-LEVEL settings-row layout (same filename => app
resource wins over the library's). Identical to the library original EXCEPT
that both text views get a width cap and may wrap to 2 lines.
PlayerControlView measures this list with MeasureSpec.UNSPECIFIED, so without
a cap a long value (e.g. the current audio track under "Audio") lays out on
one very wide line and the PopupWindow silently clips it. IDs (exo_icon /
exo_main_text / exo_sub_text) are preserved so media3's adapter still binds. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:minWidth="@dimen/exo_setting_width"
              android:minHeight="@dimen/exo_settings_height"
              android:background="?android:attr/selectableItemBackground"
              android:layoutDirection="locale"
              android:orientation="horizontal">

    <ImageView
        android:id="@+id/exo_icon"
        android:layout_width="@dimen/exo_settings_icon_size"
        android:layout_height="@dimen/exo_settings_icon_size"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:layout_marginTop="12dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/exo_settings_height"
        android:layout_marginLeft="2dp"
        android:layout_marginRight="2dp"
        android:paddingEnd="4dp"
        android:paddingRight="4dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:gravity="center|start"
        android:layoutDirection="locale"
        android:orientation="vertical">

        <TextView
            android:id="@+id/exo_main_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="260dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@color/exo_white"
            android:textDirection="locale"
            android:textSize="@dimen/exo_settings_main_text_size" />

        <TextView
            android:id="@+id/exo_sub_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="260dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@color/exo_white_opacity_70"
            android:textDirection="locale"
            android:textSize="@dimen/exo_settings_sub_text_size" />
        </LinearLayout>

    </LinearLayout>
