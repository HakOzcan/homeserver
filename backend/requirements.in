# What the backend asks for. requirements.txt is the lock generated from it;
# the Dockerfile installs the lock, never this file.
# To upgrade on purpose, run on the server from the repo root (drop the "# "):
#   docker run --rm -v "$PWD/backend:/b:ro" -w /b python:3.11-slim \
#     sh -c "pip install -q -r requirements.in && pip freeze" \
#     > backend/requirements.txt
# then put the "# Generated from..." line back at the top of requirements.txt.
