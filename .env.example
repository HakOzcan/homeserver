# Copy to .env and fill in real values. .env is not shell: values are taken
# verbatim, $(...) is NOT executed - generate secrets in your shell and paste.

# --- Domains (nginx-proxy / Let's Encrypt) ---
VIRTUAL_HOST=example.com
LETSENCRYPT_HOST=example.com
BACKEND_VIRTUAL_HOST=api.example.com
BACKEND_LETSENCRYPT_HOST=api.example.com
LETSENCRYPT_EMAIL=you@example.com
FRONTEND_URL=https://example.com
API_BASE_URL=https://api.example.com

# --- Database ---
POSTGRES_USER=homeserver
POSTGRES_PASSWORD=change-me
POSTGRES_DB=homeserver
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Auth ---
# openssl rand -hex 32
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ACTIVATION_TOKEN_EXPIRE_HOURS=24

# --- Email (account activation) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=change-me
SMTP_FROM=you@example.com

# --- Media metadata ---
TMDB_API_KEY=change-me

# --- Cloudflare DDNS ---
CF_API_TOKEN=change-me
CF_ZONE=example.com

# --- Cloud gaming (WebRTC / TURN) ---
# openssl rand -hex 32 - must match nothing else, shared by coturn/backend/game-runner
TURN_SECRET=change-me
# The server's LAN IP (set a DHCP reservation so it never changes)
SERVER_LAN_IP=192.168.1.10
# Public hostname browsers reach the TURN relay at
TURN_HOST=example.com
